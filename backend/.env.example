GOOGLE_APPLICATION_CREDENTIALS=./your-firebase-service-account.json
ASSEMBLYAI_API_KEY=your-assemblyai-api-key
TRANSCRIPTION_VERSION=1
LAYER1_VERSION=1
LAYER2_VERSION=1
GUARDRAIL_VERSION=1
POC_MAX_AUDIO_DURATION_SEC=90
POC_MAX_AUDIO_SIZE_MB=25
POC_MAX_ACTIVE_FILES_PER_USER=5
POC_MIN_AUDIO_RMS=0.001
POC_MIN_TRANSCRIPT_WORDS=3
POC_MIN_TRANSCRIPT_WORDS_PER_MINUTE=5
POC_MIN_AVG_WORD_CONFIDENCE=0.35
LLM_FAST_API_KEY=your-fast-api-key
LLM_FAST_BASE_URL=https://api.groq.com/openai/v1
LLM_FAST_MODEL=openai/gpt-oss-20b
LLM_QUALITY_API_KEY=your-quality-api-key
LLM_QUALITY_BASE_URL=https://api.groq.com/openai/v1
LLM_QUALITY_MODEL=openai/gpt-oss-120b
API_HOST=0.0.0.0
API_PORT=8000
TUSD_PORT=8081
TUSD_UPLOAD_DIR=./storage/uploads
TUSD_HOOK_URL=http://127.0.0.1:8000/hooks/tusd
TUSD_HOOK_EVENTS=pre-create,post-finish
