location = "nbg1"

# This public key is installed for root access during server creation.
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# Replace these documentation addresses with the operator and demo client public
# addresses. The configuration rejects 0.0.0.0/0.
ssh_source_ranges         = ["203.0.113.10/32"]
application_source_ranges = ["203.0.113.10/32"]

# Use "main" for convenience or, preferably, pin the commit used in the demo.
repository_ref = "main"
